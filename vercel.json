{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "django",
  "regions": ["sin1"],
  "functions": {
    "wsgi.py": {
      "excludeFiles": "{static_src/**,staticfiles/**,Kiwi/.git/**,Kiwi/docs/**,Kiwi/tests/**}"
    }
  },
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/static/images/favicon.ico" },
    { "source": "/robots.txt", "destination": "/static/robots.txt" }
  ]
}
