# Salin ke ~/kiwi-tcms/.env di server lalu isi nilainya. Jangan di-commit.
# chmod 600 .env

# Buat dengan: .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(64))"
KIWI_SECRET_KEY=change-me

# Pisahkan dengan koma. Isi domain dan/atau IP server.
KIWI_ALLOWED_HOSTS=199.180.128.65
KIWI_CSRF_TRUSTED_ORIGINS=https://199.180.128.65

KIWI_DB_NAME=kiwi
KIWI_DB_USER=kiwi
KIWI_DB_PASSWORD=change-me
KIWI_DB_HOST=localhost
KIWI_DB_PORT=5432

# Opsional (default sudah ini)
