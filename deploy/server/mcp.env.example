# Salin ke deploy/server/mcp.env di server lalu isi. Jangan di-commit.
# chmod 600 mcp.env
#
# Berisi pengaturan SERVER saja. Password Kiwi dan token Zebrunner TIDAK disimpan di sini:
# tiap QA mengirimnya sendiri lewat header di config AI-nya.

# Kiwi yang dipanggil MCP lewat /json-rpc/. Domain publik tidak butuh perubahan di Kiwi.
# (Alternatif lebih cepat: http://127.0.0.1:8000, tetapi 127.0.0.1 harus ada di KIWI_ALLOWED_HOSTS.)
KIWI_URL=https://<domain-kiwi>

# Workspace Zebrunner yang diizinkan. Host lain ditolak, supaya token QA tidak bisa dikirim ke tempat lain.
ZEBRUNNER_URL=https://<workspace>.zebrunner.com

# Host yang dikenali saat permintaan datang lewat nginx (header Host), pisahkan dengan koma.
MCP_ALLOWED_HOSTS=<domain-kiwi>

# Alamat publik MCP, dipakai untuk membuat link upload.
MCP_PUBLIC_URL=https://<domain-kiwi>/mcp

# Link upload sekali pakai untuk file besar. Default MATI: aktifkan hanya bila benar-benar dipakai,
# karena fitur ini menambah satu URL publik (/mcp/upload/...). Isi 1 untuk mengaktifkan.
#MCP_ENABLE_UPLOAD=1
